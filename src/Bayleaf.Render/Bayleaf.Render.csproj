<Project Sdk="Microsoft.NET.Sdk">

  <!-- L3: the renderer. Material graphs (.bmaterial), their node kinds and the compiler to the WGSL
       surface function the mesh shader takes; extraction, which turns a scene into a GPU-independent
       Frame; and the WebGPU renderer that draws a frame (through Bayleaf.Native's wgpu-native). -->
  <PropertyGroup>
    <RootNamespace>Bayleaf.Render</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bayleaf.Core\Bayleaf.Core.csproj" />
    <ProjectReference Include="..\Bayleaf.Native\Bayleaf.Native.csproj" />
    <ProjectReference Include="..\Bayleaf.Graph\Bayleaf.Graph.csproj" />
    <ProjectReference Include="..\Bayleaf.Scene\Bayleaf.Scene.csproj" />
    <ProjectReference Include="..\Bayleaf.Assets\Bayleaf.Assets.csproj" />
  </ItemGroup>

  <!-- One copy of each shader: the Rust renderer's, embedded from where it is (until stage 8 moves it). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\rust\crates\render\src\shaders\*.wgsl" LogicalName="Bayleaf.Render.Shaders.%(Filename)%(Extension)" Link="Shaders\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bayleaf.Render.Tests" />
  </ItemGroup>

</Project>
