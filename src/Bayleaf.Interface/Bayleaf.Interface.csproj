<Project Sdk="Microsoft.NET.Sdk">

  <!-- L2: game interfaces: layout files (.bui) of nested elements, style files (.bstyle) of rules,
       and the flexible-box layout that places them on a screen. Its namespace is Bayleaf.GameInterface, as
       Interface is a reserved word of other .NET languages (CA1716). -->
  <PropertyGroup>
    <RootNamespace>Bayleaf.GameInterface</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bayleaf.Core\Bayleaf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bayleaf.Interface.Tests" />
  </ItemGroup>

</Project>
