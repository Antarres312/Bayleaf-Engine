<Project>

  <!-- Settings every project of the C# tree shares (docs/csharp-redesign.md, "Layout"):
       nullable reference types, warnings as errors, the .NET analyzers at their recommended level and
       no suppressions. `tools/Bayleaf.Check` checks that no project turns them off. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\target\dotnet</ArtifactsPath>
  </PropertyGroup>

</Project>
