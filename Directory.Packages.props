<Project>

  <!-- Every package of the C# tree, at one version. A package's licence must be on the Craft list
       (AGENTS.md rule 26); the licences check of tools/Bayleaf.Check reads them. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- WebGPU for the renderer (docs/csharp-redesign.md, "Rendering"): the bindings and the
         wgpu-native library they load, both MIT. -->
    <PackageVersion Include="Silk.NET.WebGPU" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" />
  </ItemGroup>

</Project>
