[
  {"cmd": "project.new", "params": {"path": "$out/p"}},
  {"cmd": "asset.import", "params": {"files": ["$root/tests/files/assets/gltf-skinned.gltf"]}},
  {"cmd": "scene.file.place", "params": {"path": "gltf-skinned/gltf-skinned.gltf", "position": [1, 2, 3]}},
  {"cmd": "scene.component.add", "params": {"id": "$2.id", "component": "modelAnimation"}},
  {"cmd": "animation.joint.get", "params": {"id": "$2.id", "joint": "Knee"}},
  {"cmd": "animation.get", "params": {"id": "$2.id"}},
  {"cmd": "animation.preview", "params": {"id": "$2.id", "clip": "Bend", "time": 2, "playing": false}},
  {"cmd": "animation.joint.get", "params": {"id": "$2.id", "joint": "Knee"}},
  {"cmd": "animation.preview", "params": {"id": "$2.id", "clip": "Bend", "time": 0.75}},
  {"cmd": "animation.joint.get", "params": {"id": "$2.id", "joint": "Hip"}},
  {"cmd": "animation.preview", "params": {"id": "$2.id", "clip": "Bend", "playing": true}},
  {"cmd": "animation.play", "params": {"id": "$2.id", "clip": "Animation 2", "fade": 0.5, "loop": false, "speed": 2}},
  {"cmd": "animation.parameter.set", "params": {"id": "$2.id", "name": "aim", "value": 0.75}},
  {"cmd": "animation.parameter.set", "params": {"id": "$2.id", "name": "crouch", "value": true}},
  {"cmd": "animation.trigger", "params": {"id": "$2.id", "name": "jump"}},
  {"cmd": "animation.play", "params": {"id": "$2.id", "mix": [{"clip": "Bend", "at": 0}, {"clip": "Animation 2", "at": 1}], "by": "aim", "fade": 0}},
  {"cmd": "animation.play", "params": {"id": "$2.id", "mix": [{"clip": "Bend", "at": -1.5}], "by": 0.5}},
  {"cmd": "animation.play", "params": {"id": "$2.id", "clip": "Bend", "layer": "Knee", "fade": 0.1}},
  {"cmd": "animation.stop", "params": {"id": "$2.id", "layer": "Knee", "fade": 0}},
  {"cmd": "animation.stop", "params": {"id": "$2.id"}},
  {"cmd": "animation.preview.stop", "params": {"id": "$2.id"}},
  {"cmd": "animation.get", "params": {"id": "$2.id"}},
  {"cmd": "scene.document"}
]
