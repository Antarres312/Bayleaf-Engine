{
  "format": "bayleaf.interface",
  "version": 2,
  "root": {
    "kind": "column",
    "name": "Sign",
    "style": {
      "alignItems": "center",
      "background": "#1d2b23eb",
      "borderColor": "#7ea98d",
      "borderWidth": "4px",
      "gap": "14px",
      "height": "100%",
      "justify": "center",
      "padding": "24px",
      "radius": "28px",
      "width": "100%"
    },
    "children": [
      {
        "kind": "text",
        "name": "Title",
        "text": "Bayleaf Engine",
        "style": {
          "color": "#eef5ee",
          "fontSize": "72px"
        }
      },
      {
        "kind": "text",
        "name": "Line",
        "text": "An interface standing in the world",
        "style": {
          "color": "#a9c9b2",
          "fontSize": "30px"
        }
      },
      {
        "kind": "button",
        "name": "Wave",
        "text": "Wave back",
        "onClick": "wave",
        "style": {
          "fontSize": "30px"
        }
      }
    ]
  }
}
